# ==============================================================================
# StrukKu Environment Configuration Template (.env.example)
# ==============================================================================
# Petunjuk:
# 1. Untuk Lingkungan Lokal (Development):
#    Salin file ini menjadi .env.local (`cp .env.example .env.local`)
#    dan isi dengan kredensial Supabase project Development Anda.
# 2. Untuk Lingkungan Produksi (Production):
#    Tambahkan variabel-variabel berikut di dashboard hosting Anda (Vercel Project Settings -> Environment Variables).
# 3. Kredensial rahasia (service role, DB passwords) TIDAK BOLEH berawalan VITE_
#    dan hanya digunakan di environment backend/GitHub Secrets.
# ==============================================================================

# Supabase API (Frontend Public)
# Dapatkan dari Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Dukungan & Layanan Pengguna (Format nomor WhatsApp internasional tanpa tanda +)
VITE_SUPPORT_WA="6281234567890"

# Monitoring & Error Reporting (Sentry) - Diperlukan untuk Fase 2
VITE_SENTRY_DSN=""

# Product Analytics & Session Replay (PostHog) - Diperlukan untuk Fase 2
VITE_POSTHOG_KEY=""
VITE_POSTHOG_HOST="https://us.i.posthog.com"

# ==============================================================================
# Server / CI / GitHub Secrets (JANGAN masukkan ke file .env publik)
# ==============================================================================
# SUPABASE_DB_URL="postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres"
# BACKUP_ENCRYPTION_KEY="strong-passphrase-for-backup-aes256"
# SUPABASE_SERVICE_ROLE_KEY="eyJh..."
# SENTRY_AUTH_TOKEN="sntrys_..."
